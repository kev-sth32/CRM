# ==========================================
# SalesOS Production SaaS Environment Config
# ==========================================

# Server Port and Environment
PORT=3000
NODE_ENV=production

# ------------------------------------------
# PostgreSQL Database Connection
# ------------------------------------------
# When set, the system uses PostgreSQL with full transactional ACID compliance.
# Omit for lightweight local testing with JSON fallback (data.json).
DATABASE_URL=postgresql://salesos_user:salesos_secure_password@localhost:5432/salesos_db
PGSSL=require

# ------------------------------------------
# Transactional Email Delivery
# ------------------------------------------
# Used for real outbound customer emails, proposals, and quote sign-off links.
# Supports Resend API or standard SMTP.
RESEND_API_KEY=re_123456789_abcdef
EMAIL_FROM=SalesOS <notifications@salesos.io>

# Optional SMTP Configuration (Alternative to Resend)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxxx

# ------------------------------------------
# SaaS Subscription & Stripe Billing
# ------------------------------------------
# Enables live credit card payments, monthly subscriptions, and Customer Portal.
STRIPE_SECRET_KEY=sk_live_51xxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxx
STRIPE_PUBLIC_KEY=pk_live_51xxxxxxxxxxxxxx

# ------------------------------------------
# AI Provider Activation
# ------------------------------------------
# Choose: 'openai' or 'gemini' (Defaults to safe simulated copilot if unset)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxx
# GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxx

# ------------------------------------------
# Connector & Webhook Security
# ------------------------------------------
WEBCHAT_TOKEN=wh_webchat_token_secure_value
WEBCHAT_SECRET=wh_webchat_secret_secure_value
