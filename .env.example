# .env.example — Copy this file to .env and fill in your values.
# NEVER commit .env — it is gitignored.
# This file IS committed and documents all required variables.

# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
NODE_ENV=development           # development | production | test
PORT=3000

# ─────────────────────────────────────────────
# Database (REQUIRED in production)
# ─────────────────────────────────────────────
DATABASE_URL=postgres://salesos_user:your_password@localhost:5432/salesos_db
PGSSL=                         # Set to 'require' in production with TLS

# Docker Compose DB credentials (used by docker-compose.yml)
POSTGRES_USER=salesos_user
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=salesos_db

# ─────────────────────────────────────────────
# Security (REQUIRED in production)
# ─────────────────────────────────────────────
# AES-256 encryption key for tenant secrets (32+ char random string)
ENCRYPTION_SECRET=

# REQUIRED: Rotate the NVIDIA API key immediately if it was ever committed to git!
# SEC-1: Run: git filter-branch or BFG Repo-Cleaner to purge from history.
AI_API_KEY=nvapi-REPLACE_WITH_YOUR_ROTATED_KEY

# Test bypass secret — ONLY for non-production environments.
# SEC-3: Must be a cryptographically random string, NOT 'salesos-internal-test'.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TEST_BYPASS_SECRET=

# ─────────────────────────────────────────────
# Redis (RECOMMENDED for production scaling)
# ─────────────────────────────────────────────
# DEVOPS-3: Required for horizontal scaling (multiple web replicas).
# Without this, sessions are in-memory and not shared across instances.
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
# AI Provider
# ─────────────────────────────────────────────
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=meta/llama-3.2-11b-vision-instruct
AI_MODEL_REASONING=meta/llama-3.2-90b-vision-instruct
AI_MODEL_GUARD=meta/llama-guard-4-12b

# ─────────────────────────────────────────────
# Email
# ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@salesos.io

# ─────────────────────────────────────────────
# Billing (Stripe)
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
# Observability / Metrics
# ─────────────────────────────────────────────
# SEC-9: CIDR prefix for Prometheus scraper IP (e.g. '10.0.0.')
# Leave empty to restrict metrics to localhost + superadmin only
METRICS_ALLOWED_CIDR=

# ─────────────────────────────────────────────
# Backups (DEVOPS-1)
# ─────────────────────────────────────────────
S3_BACKUP_BUCKET=              # e.g. s3://my-company-backups/salesos
AWS_DEFAULT_REGION=ap-south-1

# ─────────────────────────────────────────────
# Proxy & Trust
# ─────────────────────────────────────────────
TRUST_PROXY=false              # Set to 'true' when behind nginx/ALB
